{
  "name": "roaring-lions",
  "version": "0.125.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @lions/app dev",
    "build": "pnpm --filter @lions/app build",
    "test": "vitest run",
    "test:determinism": "vitest run packages/sim/src/determinism.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "lint": "eslint .",
    "validate:data": "node tools/validate_data.mjs",
    "validate:meshes": "python3 tools/validate_mesh_assets.py",
    "validate:ui": "node tools/validate_ui_palette.mjs && node tools/validate_i18n.mjs",
    "validate:audio": "python3 tools/validate_audio.py && python3 tools/test_gen_audio_args.py && python3 tools/test_validate_audio_voices.py && python3 tools/test_validate_audio_ui.py && python3 tools/test_validate_audio_mix.py && python3 tools/test_validate_audio_ambience.py && python3 tools/test_validate_audio_music.py && python3 tools/test_validate_audio_engines.py",
    "balance": "pnpm --filter @lions/tools balance",
    "playtest": "pnpm --filter @lions/tools playtest",
    "versus:probe": "pnpm --filter @lions/tools versus:probe",
    "versus:breach": "pnpm --filter @lions/tools versus:breach",
    "perf:units": "pnpm --filter @lions/tools perf:units",
    "perf:load": "pnpm --filter @lions/tools perf:load",
    "perf:memory": "pnpm --filter @lions/tools perf:memory",
    "perf:lowend": "pnpm --filter @lions/tools perf:lowend",
    "ground:capture": "pnpm --filter @lions/tools ground:capture",
    "golden-baseline": "pnpm --filter @lions/tools golden-baseline",
    "golden-baseline:bless": "pnpm --filter @lions/tools golden-baseline:bless",
    "gen:luts": "node tools/gen_luts.mjs",
    "encode:meshes": "pnpm --filter @lions/tools encode:meshes",
    "wreck:meshes": "pnpm --filter @lions/tools wreck:meshes",
    "damage:meshes": "pnpm --filter @lions/tools damage:meshes",
    "kit:meshes": "pnpm --filter @lions/tools kit:meshes",
    "running-gear:meshes": "pnpm --filter @lions/tools running-gear:meshes",
    "ui:shots": "pnpm --filter @lions/tools ui:shots",
    "ui:routes": "pnpm --filter @lions/tools ui:routes",
    "net:engines": "pnpm --filter @lions/tools net:engines",
    "agent": "pnpm --silent --filter @lions/tools agent",
    "arena": "pnpm --filter @lions/tools arena",
    "blast:capture": "pnpm --filter @lions/tools blast:capture",
    "atgm:capture": "pnpm --filter @lions/tools atgm:capture",
    "tunnel:capture": "pnpm --filter @lions/tools tunnel:capture",
    "banner:capture": "pnpm --filter @lions/tools banner:capture",
    "radio:clips": "pnpm --filter @lions/tools radio:clips",
    "audio:mix": "pnpm --filter @lions/tools audio:mix",
    "weight:capture": "pnpm --filter @lions/tools weight:capture",
    "plate:host": "pnpm --filter @lions/tools plate:host",
    "plates:units": "pnpm --filter @lions/tools plates:units",
    "kit:capture": "pnpm --filter @lions/tools kit:capture",
    "vdmg:capture": "pnpm --filter @lions/tools vdmg:capture",
    "closeups:garage": "pnpm --filter @lions/tools closeups:garage",
    "gait:meshes": "pnpm --filter @lions/tools gait:meshes",
    "motion:meshes": "pnpm --filter @lions/tools motion:meshes",
    "meshy": "pnpm --filter @lions/tools meshy --",
    "video": "pnpm --filter @lions/tools video --",
    "stills:cinematics": "pnpm --filter @lions/tools stills:cinematics --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "~30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}

{
  "name": "roaring-lions",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @lions/app dev",
    "build": "pnpm --filter @lions/app build",
    "test": "vitest run",
    "test:determinism": "vitest run packages/sim/src/determinism.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "node tools/validate_data.mjs",
    "validate:assets": "python3 tools/validate_assets.py",
    "validate:meshes": "python3 tools/validate_mesh_assets.py",
    "validate:ui": "node tools/validate_ui_palette.mjs",
    "validate:audio": "python3 tools/validate_audio.py",
    "balance": "pnpm --filter @lions/tools balance",
    "playtest": "pnpm --filter @lions/tools playtest",
    "perf:units": "pnpm --filter @lions/tools perf:units",
    "golden-baseline": "pnpm --filter @lions/tools golden-baseline",
    "golden-baseline:bless": "pnpm --filter @lions/tools golden-baseline:bless",
    "golden-diff:compare": "pnpm --filter @lions/tools golden-diff:compare",
    "gen:luts": "node tools/gen_luts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "ajv": "^8.17.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}

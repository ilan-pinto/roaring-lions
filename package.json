{
  "name": "roaring-lions",
  "version": "0.121.6",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @lions/app dev",
    "build": "pnpm --filter @lions/app build",
    "test": "vitest run",
    "test:determinism": "vitest run packages/sim/src/determinism.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "node tools/validate_data.mjs",
    "validate:meshes": "python3 tools/validate_mesh_assets.py",
    "validate:ui": "node tools/validate_ui_palette.mjs && node tools/validate_i18n.mjs",
    "validate:audio": "python3 tools/validate_audio.py && python3 tools/test_gen_audio_args.py && python3 tools/test_validate_audio_voices.py && python3 tools/test_validate_audio_ui.py && python3 tools/test_validate_audio_mix.py",
    "balance": "pnpm --filter @lions/tools balance",
    "playtest": "pnpm --filter @lions/tools playtest",
    "perf:units": "pnpm --filter @lions/tools perf:units",
    "perf:load": "pnpm --filter @lions/tools perf:load",
    "ground:capture": "pnpm --filter @lions/tools ground:capture",
    "golden-baseline": "pnpm --filter @lions/tools golden-baseline",
    "golden-baseline:bless": "pnpm --filter @lions/tools golden-baseline:bless",
    "gen:luts": "node tools/gen_luts.mjs",
    "encode:meshes": "pnpm --filter @lions/tools encode:meshes",
    "wreck:meshes": "pnpm --filter @lions/tools wreck:meshes",
    "kit:meshes": "pnpm --filter @lions/tools kit:meshes",
    "ui:shots": "pnpm --filter @lions/tools ui:shots",
    "ui:routes": "pnpm --filter @lions/tools ui:routes",
    "blast:capture": "pnpm --filter @lions/tools blast:capture",
    "atgm:capture": "pnpm --filter @lions/tools atgm:capture",
    "radio:clips": "pnpm --filter @lions/tools radio:clips",
    "weight:capture": "pnpm --filter @lions/tools weight:capture",
    "plate:host": "pnpm --filter @lions/tools plate:host",
    "plates:units": "pnpm --filter @lions/tools plates:units",
    "kit:capture": "pnpm --filter @lions/tools kit:capture",
    "closeups:garage": "pnpm --filter @lions/tools closeups:garage",
    "gait:meshes": "pnpm --filter @lions/tools gait:meshes",
    "motion:meshes": "pnpm --filter @lions/tools motion:meshes",
    "meshy": "pnpm --filter @lions/tools meshy --"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "ajv": "^8.17.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.136.3"
  }
}

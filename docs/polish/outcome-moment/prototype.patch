@@ -0,0 +1,39 @@
+# Compose a labelled frame-strip sheet. usage: sheet.py <spec.json> <out.jpg>
+# spec: {"title": str, "cols": [label...], "rows": [{"label": str, "note": str, "files": [path...]}], "w": 440, "foot": [str...]}
+import json, sys
+from PIL import Image, ImageDraw, ImageFont
+spec = json.load(open(sys.argv[1]))
+W = spec.get('w', 440); H = int(W * 900 / 1440)
+LBL = spec.get('lbl', 230); PAD = 10; TOP = 70; HEAD = 26
+font_path = '/Users/ilpinto/dev/roaring-lions-ep/outcome-mock/assets/fonts/barlow-latin-600.woff2'
+def f(sz):
+    for p in ['/System/Library/Fonts/Supplemental/Arial.ttf', '/System/Library/Fonts/Helvetica.ttc']:
+        try: return ImageFont.truetype(p, sz)
+        except Exception: pass
+    return ImageFont.load_default()
+F1, F2, F3 = f(26), f(17), f(14)
+cols = spec['cols']; rows = spec['rows']; foot = spec.get('foot', [])
+sw = LBL + len(cols) * (W + PAD) + PAD
+sh = TOP + HEAD + len(rows) * (H + PAD) + 20 + 20 * len(foot)
+img = Image.new('RGB', (sw, sh), (24, 24, 22))
+d = ImageDraw.Draw(img)
+d.text((PAD, 18), spec['title'], font=F1, fill=(236, 230, 214))
+for i, c in enumerate(cols):
+    d.text((LBL + i * (W + PAD) + 4, TOP), c, font=F2, fill=(200, 196, 180))
+y = TOP + HEAD
+for r in rows:
+    d.text((PAD, y + 6), r['label'], font=F2, fill=(236, 230, 214))
+    yy = y + 32
+    for line in r.get('note', '').split('\n'):
+        d.text((PAD, yy), line, font=F3, fill=(170, 166, 150)); yy += 18
+    for i, p in enumerate(r['files']):
+        im = Image.open(p).convert('RGB')
+        if 'crop' in r: im = im.crop(tuple(r['crop']))
+        im = im.resize((W, int(W * im.height / im.width)), Image.LANCZOS)
+        img.paste(im, (LBL + i * (W + PAD), y))
+    y += H + PAD
+y += 10
+for line in foot:
+    d.text((PAD, y), line, font=F3, fill=(170, 166, 150)); y += 20
+img.save(sys.argv[2], quality=86, optimize=True, progressive=True)
+print(sys.argv[2], img.size)
diff --git a/tools/src/ui-review/mock/dawn_measure.py b/tools/src/ui-review/mock/dawn_measure.py
new file mode 100644
index 00000000..d0336525
--- /dev/null
+++ b/tools/src/ui-review/mock/dawn_measure.py
@@ -0,0 +1,45 @@
+# Measures each dawn option: unit pixels inside the compound (shown vs units-hidden diff),
+# their luma contrast against the ground under them, and the ground/highlight luma.
+import json, sys, numpy as np
+from PIL import Image, ImageDraw
+D = sys.argv[1]
+m = json.load(open(f'{D}/meta.json'))
+def luma(a): return 0.2126*a[...,0] + 0.7152*a[...,1] + 0.0722*a[...,2]
+out = {}
+for tick, info in m['frames'].items():
+    mask = Image.new('L', (1440, 900), 0)
+    ImageDraw.Draw(mask).polygon([tuple(p) for p in info['poly']], fill=255)
+    inside = np.array(mask) > 0
+    # One unit mask for every option: the union of where units differ, so each option is judged on the same pixels.
+    um = np.zeros((900, 1440), bool)
+    sb = luma(np.asarray(Image.open(f"{D}/t{tick}-shipped-nounits.png").convert('RGB')).astype(float))
+    shade = um & (sb < 70)   # unit pixels standing on ground the shipped dawn leaves in shadow
+    for o in m['options']:
+        a = np.asarray(Image.open(f"{D}/t{tick}-{o['id']}.png").convert('RGB')).astype(float)
+        b = np.asarray(Image.open(f"{D}/t{tick}-{o['id']}-nounits.png").convert('RGB')).astype(float)
+        um |= np.abs(a-b).sum(-1) > 24
+    um &= inside
+    sb = luma(np.asarray(Image.open(f"{D}/t{tick}-shipped-nounits.png").convert('RGB')).astype(float))
+    shade = um & (sb < 70)   # unit pixels standing on ground the shipped dawn leaves in shadow
+    for o in m['options']:
+        a = np.asarray(Image.open(f"{D}/t{tick}-{o['id']}.png").convert('RGB')).astype(float)
+        b = np.asarray(Image.open(f"{D}/t{tick}-{o['id']}-nounits.png").convert('RGB')).astype(float)
+        la, lb = luma(a), luma(b)
+        c = np.abs(la-lb)[um]
+        ground = lb[inside & ~um]
+        out.setdefault(o['id'], {})[tick] = dict(
+            unit_px=int(um.sum()),
+            unit_contrast_mean=round(float(c.mean()),1),
+            unit_px_read_ge20=round(float((c>=20).mean()),3),
+            unit_luma_median=round(float(np.median(la[um])),1),
+            unit_px_crushed_lt30=round(float((la[um]<30).mean()),3),
+            shade_unit_px=int(shade.sum()),
+            shade_contrast_mean=round(float(np.abs(la-lb)[shade].mean()),1),
+            shade_px_read_ge20=round(float((np.abs(la-lb)[shade]>=20).mean()),3),
+            compound_ground_luma_median=round(float(np.median(ground)),1),
+            compound_ground_luma_p10=round(float(np.percentile(ground,10)),1),
+            frame_luma_p90=round(float(np.percentile(lb,90)),1),
+            frame_luma_mean=round(float(lb.mean()),1))
+json.dump(out, open(f'{D}/numbers.json','w'), indent=1)
+for k,v in out.items():
+    for t,r in v.items(): print(k.ljust(22), t.rjust(5), r)

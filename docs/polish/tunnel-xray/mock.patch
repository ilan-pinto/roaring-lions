+    this.beam.visible = false;
+    this.beam.frustumCulled = false;
+    this.beam.renderOrder = renderOrder + 0.1;
+    this.group.add(this.beam);
+    this.renderOrder = renderOrder;
+  }
+  private readonly renderOrder: number;
+
+  /** Route geometry is load-time data: built once. */
+  build(routes: readonly XrayRoute[], groundY: (x: number, y: number) => number): void {
+    const tubes: THREE.BufferGeometry[] = [];
+    const collars: THREE.BufferGeometry[] = [];
+    this.routes = [];
+    routes.forEach((route, r) => {
+      const n = route.points.length;
+      const centres = new Float32Array(n * 3);
+      const tangents = new Float32Array(n * 2);
+      // The bore does not follow every bump: a moving average of the ground
+      // over +-1.5 tiles, then held at least a bore's height under the
+      // ground at each sample, so it neither climbs a cliff face nor breaks
+      // the surface on a crest.
+      const gy = route.points.map(([x, y]) => groundY(x, y));
+      const W = 6;
+      for (let i = 0; i < n; i++) {
+        const [x, y] = route.points[i];
+        let sum = 0;
+        let cnt = 0;
+        for (let j = Math.max(0, i - W); j <= Math.min(n - 1, i + W); j++) {
+          sum += gy[j];
+          cnt++;
+        }
+        centres[i * 3] = x;
+        centres[i * 3 + 1] = Math.min(sum / cnt - DEPTH, gy[i] - RV - 0.12);
+        centres[i * 3 + 2] = y;
+        const a = route.points[Math.max(0, i - 1)];
+        const b = route.points[Math.min(n - 1, i + 1)];
+        const dx = b[0] - a[0];
+        const dz = b[1] - a[1];
+        const l = Math.hypot(dx, dz) || 1;
+        tangents[i * 2] = dx / l;
+        tangents[i * 2 + 1] = dz / l;
+      }
+      this.routes.push({ centres, tangents, length: route.length });
+      tubes.push(boreGeometry(centres, tangents, r));
+      for (const [end, kind] of [
+        [0, 0],
+        [n - 1, 1],
+      ] as const) {
+        const cx = centres[end * 3];
+        const cz = centres[end * 3 + 2];
+        const top = groundY(cx, cz);
+        tubes.push(shaftGeometry(cx, centres[end * 3 + 1], top - 0.02, cz, r, kind === 0 ? 0 : route.length));
+        collars.push(collarGeometry(cx, top + 0.03, cz, r, kind, kind === 0 ? 0 : route.length));
+      }
+    });
+    if (this.tube) this.group.remove(this.tube);
+    if (this.collars) this.group.remove(this.collars);
+    if (tubes.length === 0) return;
+    this.tube = new THREE.Mesh(mergeGeometries(tubes), this.tubeMat);
+    this.tube.renderOrder = this.renderOrder;
+    this.tube.frustumCulled = false;
+    this.collars = new THREE.Mesh(mergeGeometries(collars), this.collarMat);
+    this.collars.renderOrder = this.renderOrder;
+    this.collars.frustumCulled = false;
+    this.group.add(this.tube, this.collars);
+  }
+
+  /** 5 Hz: what the sim says about each route. `level` is side 0's contact
+   *  level after the collapse downgrade; `held` is "a mark_tunnel carrier sees
+   *  some tile of it right now". */
+  setRouteState(r: number, level: 0 | 1 | 2, held: boolean, nowS: number): void {
+    if (level === 2 && held) this.lastHeldS[r] = nowS;
+    if (level !== 2) {
+      this.target[r] = 0;
+      return;
+    }
+    const since = nowS - this.lastHeldS[r];
+    this.target[r] = since <= 0.3 ? 1 : Math.max(FADE_FLOOR, 1 - (since / FADE_S) * (1 - FADE_FLOOR));
+  }
+
+  /** The `tunnelContact` identified event, side 0. */
+  discover(r: number, nowS: number, observer: { x: number; y: number; h: number } | null, groundY: (x: number, y: number) => number): void {
+    const rt = this.routes[r];
+    if (!rt) return;
+    // Re-acquiring a route already found this mission re-lights it without
+    // the beat: the sweep runs again, no beam, no flash.
+    const first = !this.found.has(r);
+    this.found.add(r);
+    this.pulseRepeat[r] = first ? 0 : 1;
+    this.lastHeldS[r] = nowS;
+    let best = 0;
+    if (observer) {
+      let bestD = Infinity;
+      const n = rt.centres.length / 3;
+      for (let i = 0; i < n; i++) {
+        const d = Math.hypot(rt.centres[i * 3] - observer.x, rt.centres[i * 3 + 2] - observer.y);
+        if (d < bestD) {
+          bestD = d;
+          best = i;
+        }
+      }
+      this.beamFrom.set(observer.x, groundY(observer.x, observer.y) + observer.h, observer.y);
+      this.beamTo.set(rt.centres[best * 3], rt.centres[best * 3 + 1] + RV, rt.centres[best * 3 + 2]);
+      if (first) this.beamStartS = nowS;
+    } else {
+      best = Math.floor(rt.centres.length / 6);
+    }
+    this.pulseOrigin[r] = (best / Math.max(1, rt.centres.length / 3 - 1)) * rt.length;
+    this.pulseStartS[r] = nowS;
+  }
+
+  /** Per frame. `occupants` are (route, entity) pairs from `state.tunnelIn`. */
+  update(nowS: number, dtS: number, occupants: readonly (readonly [number, number])[]): void {
+    const t0 = performance.now();
+    const u = this.tubeMat.uniforms;
+    u.uTime.value = nowS;
+    const st = u.uStrength.value as Float32Array;
+    const front = u.uFront.value as Float32Array;
+    const flash = u.uFlash.value as Float32Array;
+    const origin = u.uOrigin.value as Float32Array;
+    // Smoothed on the SIM clock, like the pulse: a frozen tick repeats, a
+    // pause holds, and a capture at a pinned tick is reproducible.
+    const simDt = Math.max(0, Math.min(0.25, nowS - this.lastNowS));
+    this.lastNowS = nowS;
+    void dtS;
+    const k = Math.min(1, simDt * 4);
+    for (let r = 0; r < this.routes.length; r++) {
+      const tgt = this.enabled ? this.target[r] : 0;
+      this.strength[r] += (tgt - this.strength[r]) * (tgt < this.strength[r] ? k * 0.5 : k);
+      st[r] = this.strength[r];
+      const age = nowS - this.pulseStartS[r];
+      front[r] = age < 0 ? 0 : age * PULSE_TILES_PER_S;
+      flash[r] = age >= 0 && age < FLASH_S * 3 ? Math.exp(-age / FLASH_S) * (this.pulseRepeat[r] ? 0.25 : 1) : 0;
+      origin[r] = this.pulseOrigin[r];
+    }
+    // Figures: the sim keeps no position for a buried unit along its route,
+    // so where each one stands is presentation -- a home on the route by id,
+    // a slow pace either side of it. Revealed only where the pulse has been.
+    let n = 0;
+    for (const [r, id] of occupants) {
+      const rt = this.routes[r];
+      if (!rt || n >= MAX_FIGURES || this.strength[r] < 0.01) continue;
+      const h = hash01(id * 7919 + r * 104729);
+      const home = (0.25 + 0.6 * h) * rt.length;
+      const pace = Math.sin(nowS * (0.22 + 0.1 * h) + h * 6.28);
+      const s = Math.min(rt.length - 0.3, Math.max(0.3, home + pace * 1.1));
+      const dir = Math.cos(nowS * (0.22 + 0.1 * h) + h * 6.28) >= 0 ? 1 : -1;
+      const reveal = Math.abs(s - this.pulseOrigin[r]) <= front[r] ? 1 : 0;
+      const ns = rt.centres.length / 3;
+      const fi = (s / Math.max(rt.length, 1e-6)) * (ns - 1);
+      const i0 = Math.min(ns - 1, Math.floor(fi));
+      const i1 = Math.min(ns - 1, i0 + 1);
+      const w = fi - i0;
+      const x = rt.centres[i0 * 3] * (1 - w) + rt.centres[i1 * 3] * w;
+      const y = rt.centres[i0 * 3 + 1] * (1 - w) + rt.centres[i1 * 3 + 1] * w - RV * 0.82;
+      const z = rt.centres[i0 * 3 + 2] * (1 - w) + rt.centres[i1 * 3 + 2] * w;
+      const tx = rt.tangents[i0 * 2] * dir;
+      const tz = rt.tangents[i0 * 2 + 1] * dir;
+      const bob = Math.abs(Math.sin(nowS * 6 + h * 10)) * 0.02;
+      this.q.setFromAxisAngle(this.v.set(0, 1, 0), Math.atan2(tx, tz));
+      this.m4.compose(this.v.set(x, y + bob, z), this.q, this.s3);
+      this.figures.setMatrixAt(n, this.m4);
+      this.figureAlpha.array[n] = this.strength[r] * reveal;
+      n++;
+    }
+    this.figures.count = n;
+    this.figures.instanceMatrix.needsUpdate = true;
+    this.figureAlpha.needsUpdate = true;
+
+    const bAge = nowS - this.beamStartS;
+    if (this.enabled && bAge >= 0 && bAge < 1.2) {
+      const dir = this.v.subVectors(this.beamTo, this.beamFrom);
+      const len = dir.length();
+      this.beam.position.copy(this.beamFrom);
+      this.beam.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.normalize());
+      this.beam.scale.set(1, len, 1);
+      (this.beam.material as THREE.ShaderMaterial).uniforms.uA.value = 0.9 * (1 - bAge / 1.2);
+      this.beam.visible = true;
+    } else {
+      this.beam.visible = false;
+    }
+    this.lastUpdateMs = performance.now() - t0;
+  }
+
+  get drawCalls(): number {
+    return (this.tube ? 1 : 0) + (this.collars ? 1 : 0) + (this.figures.count > 0 ? 1 : 0) + (this.beam.visible ? 1 : 0);
+  }
+}
+
+function hash01(n: number): number {
+  let x = (n | 0) ^ 0x9e3779b9;
+  x = Math.imul(x ^ (x >>> 16), 0x85ebca6b);
+  x = Math.imul(x ^ (x >>> 13), 0xc2b2ae35);
+  x ^= x >>> 16;
+  return (x >>> 0) / 4294967296;
+}
+
+function withRouteAttrs(g: THREE.BufferGeometry, r: number, kind: number, sOf: (i: number) => number): THREE.BufferGeometry {
+  const n = g.getAttribute('position').count;
+  const aR = new Float32Array(n).fill(r);
+  const aK = new Float32Array(n).fill(kind);
+  const aS = new Float32Array(n);
+  for (let i = 0; i < n; i++) aS[i] = sOf(i);
+  g.setAttribute('aRoute', new THREE.BufferAttribute(aR, 1));
+  g.setAttribute('aKind', new THREE.BufferAttribute(aK, 1));
+  g.setAttribute('aS', new THREE.BufferAttribute(aS, 1));
+  if (!g.getAttribute('uv')) g.setAttribute('uv', new THREE.BufferAttribute(new Float32Array(n * 2), 2));
+  return g;
+}
+
+function boreGeometry(centres: Float32Array, tangents: Float32Array, r: number): THREE.BufferGeometry {
+  const n = centres.length / 3;
+  const pos = new Float32Array(n * RING * 3);
+  const nor = new Float32Array(n * RING * 3);
+  const sArr: number[] = [];
+  for (let i = 0; i < n; i++) {
+    const tx = tangents[i * 2];
+    const tz = tangents[i * 2 + 1];
+    // side vector (horizontal, perpendicular to the route), and up
+    const sx = -tz;
+    const sz = tx;
+    for (let j = 0; j < RING; j++) {
+      const a = (j / RING) * Math.PI * 2;
+      const c = Math.cos(a);
+      const s = Math.sin(a);
+      const o = (i * RING + j) * 3;
+      pos[o] = centres[i * 3] + sx * c * RH;
+      pos[o + 1] = centres[i * 3 + 1] + s * RV;
+      pos[o + 2] = centres[i * 3 + 2] + sz * c * RH;
+      const nx = (sx * c) / RH;
+      const ny = s / RV;
+      const nz = (sz * c) / RH;
+      const l = Math.hypot(nx, ny, nz) || 1;
+      nor[o] = nx / l;
+      nor[o + 1] = ny / l;
+      nor[o + 2] = nz / l;
+      sArr.push(i * STEP);
+    }
+  }
+  const idx: number[] = [];
+  for (let i = 0; i < n - 1; i++) {
+    for (let j = 0; j < RING; j++) {
+      const a = i * RING + j;
+      const b = i * RING + ((j + 1) % RING);
+      const c = (i + 1) * RING + j;
+      const d = (i + 1) * RING + ((j + 1) % RING);
+      idx.push(a, c, b, b, c, d);
+    }
+  }
+  const g = new THREE.BufferGeometry();
+  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
+  g.setAttribute('normal', new THREE.BufferAttribute(nor, 3));
+  g.setIndex(idx);
+  return withRouteAttrs(g, r, 0, (i) => sArr[i]);
+}
+
+function shaftGeometry(x: number, y0: number, y1: number, z: number, r: number, s: number): THREE.BufferGeometry {
+  const g = new THREE.CylinderGeometry(SHAFT_R, SHAFT_R, Math.max(0.05, y1 - y0), 12, 1, true);
+  g.translate(x, (y0 + y1) / 2, z);
+  return withRouteAttrs(g, r, 1, () => s);
+}
+
+function collarGeometry(x: number, y: number, z: number, r: number, kind: number, s: number): THREE.BufferGeometry {
+  const g = new THREE.RingGeometry(kind === 1 ? 0.3 : 0.22, kind === 1 ? 0.4 : 0.29, 24);
+  g.rotateX(-Math.PI / 2);
+  g.translate(x, y, z);
+  g.deleteAttribute('normal');
+  return withRouteAttrs(g, r, kind, () => s);
+}
+
+/** A crouched figure, ~1.5 m (0.5 wu): torso, head, legs and a rifle. */
+function figureGeometry(): THREE.BufferGeometry {
+  const parts: THREE.BufferGeometry[] = [];
+  const torso = new THREE.CylinderGeometry(0.055, 0.065, 0.2, 8);
+  torso.rotateX(0.35);
+  torso.translate(0, 0.27, 0.03);
+  parts.push(torso);
+  const head = new THREE.SphereGeometry(0.05, 10, 8);
+  head.translate(0, 0.42, 0.08);
+  parts.push(head);
+  for (const side of [-1, 1]) {
+    const leg = new THREE.CylinderGeometry(0.028, 0.03, 0.19, 6);
+    leg.rotateX(side * 0.3);
+    leg.translate(side * 0.04, 0.1, side * 0.03);
+    parts.push(leg);
+  }
+  const rifle = new THREE.BoxGeometry(0.018, 0.018, 0.26);
+  rifle.rotateX(-0.2);
+  rifle.translate(0.06, 0.3, 0.12);
+  parts.push(rifle);
+  for (const p of parts) p.deleteAttribute('uv');
+  return mergeGeometries(parts.map((p) => (p.index ? p.toNonIndexed() : p)));
+}

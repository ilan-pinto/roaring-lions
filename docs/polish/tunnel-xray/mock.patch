diff --git a/packages/render/src/three/tunnel-xray.ts b/packages/render/src/three/tunnel-xray.ts
new file mode 100644
index 00000000..e11e129d
--- /dev/null
+++ b/packages/render/src/three/tunnel-xray.ts
@@ -0,0 +1,527 @@
+/**
+ * MOCK (GH-471): the x-ray reveal of an identified tunnel. Not wired for
+ * shipping -- this file exists so the design sheet in
+ * `docs/polish/tunnel-xray/` is photographed from the real renderer rather
+ * than painted. Every read is presentation-only (invariant 4): route
+ * geometry from `Sim.tunnelPointAt`/`tnLength`, identification from
+ * `tunnelContactLevel` and `markerSeesTile`, occupants from
+ * `state.tunnelIn`, the discovery moment from the `tunnelContact` event.
+ * Nothing here writes to the sim.
+ *
+ * Three draws, constant, whatever the number of routes or fighters:
+ *  1. the TUBE + its two SHAFTS (mouth, vent), one merged geometry over every
+ *     route, `GreaterDepth` + the silhouette stencil (it draws only where the
+ *     ground hides it, and never over a unit body);
+ *  2. the surface COLLARS at mouth and vent, ordinary depth test;
+ *  3. the FIGURES inside, one InstancedMesh, the tube's own x-ray flags.
+ * Per-route state rides in uniform arrays indexed by an `aRoute` attribute,
+ * so a route fading or pulsing costs a uniform write, not a rebuild.
+ */
+import * as THREE from 'three';
+import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';
+import { hexToLinear } from './terrain/shared';
+import { SILHOUETTE_MATERIAL_FLAGS } from './units/silhouette';
+import { VIEW_DIRECTION } from './camera';
+
+export const XRAY_MAX_ROUTES = 16;
+/** Centre of the bore below the drawn ground, world units (1 tile = 1 wu = 3 m). */
+const DEPTH = 0.62;
+/** Half-width and half-height of the bore: an arched gallery ~1.4 m x 1.9 m. */
+const RH = 0.2;
+const RV = 0.28;
+const RING = 20;
+const STEP = 0.25;
+const SHAFT_R = 0.15;
+/** Discovery pulse speed along the route, tiles per second. */
+const PULSE_TILES_PER_S = 12;
+/** How long the discovery flash takes to settle, seconds. */
+const FLASH_S = 1.6;
+/** The sim forgets an unwatched identified route in ~322 ticks (LOST_AT); the
+ *  reveal fades over the same window, never faster. */
+const FADE_S = 16;
+const FADE_FLOOR = 0.3;
+const MAX_FIGURES = 64;
+
+export interface XrayRoute {
+  /** Samples along the route: x, y in tiles (already +0.5 to the tile centre). */
+  readonly points: readonly (readonly [number, number])[];
+  readonly length: number;
+}
+
+export interface XrayColors {
+  rim: string;
+  core: string;
+  hot: string;
+  figure: string;
+}
+
+interface RouteRuntime {
+  centres: Float32Array; // xyz per sample
+  tangents: Float32Array; // xz per sample
+  length: number;
+}
+
+export class TunnelXray {
+  readonly group = new THREE.Group();
+  private readonly tubeMat: THREE.ShaderMaterial;
+  private readonly collarMat: THREE.ShaderMaterial;
+  private readonly figureMat: THREE.ShaderMaterial;
+  private tube: THREE.Mesh | null = null;
+  private collars: THREE.Mesh | null = null;
+  private readonly figures: THREE.InstancedMesh;
+  private readonly figureAlpha: THREE.InstancedBufferAttribute;
+  private readonly beam: THREE.Mesh;
+  private routes: RouteRuntime[] = [];
+  private readonly strength = new Float32Array(XRAY_MAX_ROUTES);
+  private readonly target = new Float32Array(XRAY_MAX_ROUTES);
+  private readonly lastHeldS = new Float32Array(XRAY_MAX_ROUTES).fill(-1e9);
+  private readonly pulseStartS = new Float32Array(XRAY_MAX_ROUTES).fill(-1e9);
+  private readonly pulseOrigin = new Float32Array(XRAY_MAX_ROUTES);
+  private readonly pulseRepeat = new Uint8Array(XRAY_MAX_ROUTES);
+  private readonly found = new Set<number>();
+  private beamFrom = new THREE.Vector3();
+  private beamTo = new THREE.Vector3();
+  private beamStartS = -1e9;
+  private readonly m4 = new THREE.Matrix4();
+  private readonly q = new THREE.Quaternion();
+  private readonly v = new THREE.Vector3();
+  private readonly s3 = new THREE.Vector3(1.15, 1.15, 1.15);
+  enabled = true;
+  private lastNowS = 0;
+  /** Cost accounting for the sheet: CPU ms spent in update(), last frame. */
+  lastUpdateMs = 0;
+
+  constructor(colors: XrayColors, renderOrder: number) {
+    const lin = (h: string) => new THREE.Vector3(...hexToLinear(h));
+    const shared = {
+      uRim: { value: lin(colors.rim) },
+      uCore: { value: lin(colors.core) },
+      uHot: { value: lin(colors.hot) },
+      uTime: { value: 0 },
+      uToCam: { value: VIEW_DIRECTION.clone().normalize() },
+      uStrength: { value: new Float32Array(XRAY_MAX_ROUTES) },
+      uOrigin: { value: new Float32Array(XRAY_MAX_ROUTES) },
+      uFront: { value: new Float32Array(XRAY_MAX_ROUTES).fill(1e6) },
+      uFlash: { value: new Float32Array(XRAY_MAX_ROUTES) },
+    };
+    this.tubeMat = new THREE.ShaderMaterial({
+      ...SILHOUETTE_MATERIAL_FLAGS,
+      // Both faces: the far wall and floor (back faces) are the dark cut
+      // that reads as a trench IN the ground; the near wall (front faces) is
+      // glass, rim only.
+      side: THREE.DoubleSide,
+      defines: (globalThis as { __xrayDebug?: boolean }).__xrayDebug ? { XRAY_DEBUG: 1 } : {},
+      uniforms: shared,
+      vertexShader: /* glsl */ `
+        attribute float aS;
+        attribute float aRoute;
+        attribute float aKind;
+        varying float vS; varying float vKind; varying vec3 vN; varying float vRoute;
+        void main() {
+          vS = aS; vKind = aKind; vRoute = aRoute;
+          vN = normalize(mat3(modelMatrix) * normal);
+          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
+        }`,
+      fragmentShader: /* glsl */ `
+        #define N ${XRAY_MAX_ROUTES}
+        uniform vec3 uRim; uniform vec3 uCore; uniform vec3 uHot; uniform float uTime; uniform vec3 uToCam;
+        uniform float uStrength[N]; uniform float uOrigin[N]; uniform float uFront[N]; uniform float uFlash[N];
+        varying float vS; varying float vKind; varying vec3 vN; varying float vRoute;
+        void main() {
+          int r = int(vRoute + 0.5);
+          float st = 0.0; float o = 0.0; float f = 0.0; float fl = 0.0;
+          for (int i = 0; i < N; i++) { if (i == r) { st = uStrength[i]; o = uOrigin[i]; f = uFront[i]; fl = uFlash[i]; } }
+          float d = abs(vS - o);
+          float revealed = smoothstep(f + 0.4, f - 0.4, d);
+          float edge = exp(-pow((f - d) * 2.2, 2.0)) * fl;
+          if (st * revealed < 0.003 && edge < 0.01) discard;
+          // Ortho camera: one view vector for the whole frame (camera.ts).
+          float nz = dot(vN, uToCam);
+          // One scan band at a time, mouth -> vent (the way the threat
+          // travels), every ~2.5 s.
+          float band = mod(uTime * 6.0, 30.0) - 3.0;
+          float scan = exp(-pow((vS - band) * 1.6, 2.0)) * (1.0 - vKind);
+          vec3 col; float a;
+          if (gl_FrontFacing) {
+            // Near wall: glass. The rim is the outline of the bore.
+            float rim = pow(1.0 - abs(nz), 4.0);
+            col = mix(uRim, uHot, scan * 0.5);
+            a = st * revealed * (rim * 0.95 + scan * 0.45 + 0.03);
+          } else {
+            // Far wall and floor: the dark cut, with a cold edge where the
+            // wall turns away from the eye -- the floor line the figures walk.
+            float edgeIn = pow(1.0 - abs(nz), 3.0);
+            col = mix(uCore, uRim, clamp(edgeIn * 0.9 + scan * 0.7, 0.0, 1.0));
+            a = st * revealed * (0.62 + 0.3 * edgeIn + 0.3 * scan);
+          }
+          col = mix(col, uHot, clamp(edge, 0.0, 1.0));
+          a = a * (1.0 + 0.5 * fl);
+          a = max(a, edge * 0.9);
+          gl_FragColor = vec4(col * (1.0 + 1.4 * edge + 0.4 * fl * revealed), clamp(a, 0.0, 0.9));
+          #ifdef XRAY_DEBUG
+          gl_FragColor = gl_FrontFacing ? vec4(1.0, 0.0, 0.0, 0.5) : vec4(0.0, 1.0, 0.0, 0.5);
+          #endif
+        }`,
+    });
+    this.collarMat = new THREE.ShaderMaterial({
+      transparent: true,
+      depthTest: true,
+      depthWrite: false,
+      uniforms: shared,
+      vertexShader: /* glsl */ `
+        attribute float aRoute; attribute float aKind; attribute float aS;
+        varying float vRoute; varying float vKind; varying float vS; varying vec2 vUv;
+        void main() { vRoute = aRoute; vKind = aKind; vS = aS; vUv = uv;
+          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
+      fragmentShader: /* glsl */ `
+        #define N ${XRAY_MAX_ROUTES}
+        uniform vec3 uRim; uniform vec3 uHot; uniform float uTime;
+        uniform float uStrength[N]; uniform float uOrigin[N]; uniform float uFront[N]; uniform float uFlash[N];
+        varying float vRoute; varying float vKind; varying float vS; varying vec2 vUv;
+        void main() {
+          int r = int(vRoute + 0.5);
+          float st = 0.0; float o = 0.0; float f = 0.0; float fl = 0.0;
+          for (int i = 0; i < N; i++) { if (i == r) { st = uStrength[i]; o = uOrigin[i]; f = uFront[i]; fl = uFlash[i]; } }
+          float revealed = step(abs(vS - o), f);
+          // The vent (kind 1) breathes: it is where fighters come up.
+          float breathe = vKind > 0.5 ? 0.65 + 0.35 * sin(uTime * 3.4) : 0.8;
+          float a = st * revealed * breathe;
+          if (a < 0.01) discard;
+          gl_FragColor = vec4(mix(uRim, uHot, fl * 0.6), a);
+        }`,
+    });
+    this.figureMat = new THREE.ShaderMaterial({
+      ...SILHOUETTE_MATERIAL_FLAGS,
+      side: THREE.FrontSide,
+      uniforms: { uFig: { value: lin(colors.figure) }, uCore: shared.uCore, uToCam: shared.uToCam },
+      vertexShader: /* glsl */ `
+        attribute float aAlpha; varying float vAlpha; varying vec3 vN;
+        void main() { vAlpha = aAlpha;
+          vN = normalize(mat3(modelMatrix) * mat3(instanceMatrix) * normal);
+          gl_Position = projectionMatrix * modelViewMatrix * instanceMatrix * vec4(position, 1.0); }`,
+      fragmentShader: /* glsl */ `
+        uniform vec3 uFig; uniform vec3 uCore; uniform vec3 uToCam; varying float vAlpha; varying vec3 vN;
+        void main() {
+          if (vAlpha < 0.01) discard;
+          float fres = pow(1.0 - abs(dot(vN, uToCam)), 1.3);
+          vec3 col = mix(uFig * 0.55, uFig * 1.35, fres);
+          gl_FragColor = vec4(col, vAlpha * (0.62 + 0.38 * fres));
+        }`,
+    });
+    const fig = figureGeometry();
+    this.figureAlpha = new THREE.InstancedBufferAttribute(new Float32Array(MAX_FIGURES), 1);
+    fig.setAttribute('aAlpha', this.figureAlpha);
+    this.figures = new THREE.InstancedMesh(fig, this.figureMat, MAX_FIGURES);
+    this.figures.count = 0;
+    this.figures.frustumCulled = false;
+    this.figures.renderOrder = renderOrder + 0.05;
+    this.group.add(this.figures);
+
+    // The discovery beam: observer -> the point on the route it found.
+    const beamGeo = new THREE.CylinderGeometry(0.035, 0.11, 1, 8, 1, true);
+    beamGeo.translate(0, 0.5, 0);
+    this.beam = new THREE.Mesh(
+      beamGeo,
+      new THREE.ShaderMaterial({
+        transparent: true,
+        depthTest: false,
+        depthWrite: false,
+        uniforms: { uRim: shared.uRim, uHot: shared.uHot, uA: { value: 0 } },
+        vertexShader: `varying float vY; void main(){ vY = position.y; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.0);} `,
+        fragmentShader: `uniform vec3 uRim; uniform vec3 uHot; uniform float uA; varying float vY;
+          void main(){ gl_FragColor = vec4(mix(uHot, uRim, vY), uA * (0.35 + 0.65 * vY)); }`,
+      })

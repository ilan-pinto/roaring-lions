{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roaringlions.dev/schemas/countries.schema.json",
  "title": "Campaign countries (generated by tools/render_campaign_world.py)",
  "type": "object",
  "additionalProperties": false,
  "required": ["board", "art", "countries"],
  "properties": {
    "board": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "art": { "type": "string", "pattern": "\\.png$" },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "cell", "home", "anchor", "outline"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "cell": { "type": "integer", "minimum": 0 },
          "home": { "type": "boolean" },
          "anchor": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0 }
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          }
        }
      }
    }
  }
}

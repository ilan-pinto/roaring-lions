{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roaring-lions/schemas/feedback.schema.json",
  "title": "In-game feedback: the `meta` part of POST /api/feedback",
  "description": "GH-464, GH-1417 S3 (the `report` category: a player reporting the other player chat, source `match` only, its evidence the reporter own copy in `context`, never verified, never a GitHub issue link; it names no tester, contact or persistent player id). Spec: docs/superpowers/specs/2026-10-08-in-game-feedback-design.md (\"Server contract as built\"). The Worker's twin is packages/worker/src/feedback-meta.ts, pinned to this file by feedback-meta.test.ts. Rules a JSON Schema cannot state, enforced by the Worker: `context` serialises to at most 8192 UTF-8 bytes; the `meta` part is at most 24 KB; `text` is not whitespace-only for the five form kinds; the multipart `shot` part (image/webp ONLY, magic bytes checked) is accepted only with source `pause`, and one over 64 KB is dropped while the note is still stored (201 with dropped.picture = too_large); the `replay` part (a JSON object, <= 96 KB) only with source `pause` and category `bug`; the whole body is <= 448 KB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "t", "source", "category", "text", "build", "context"],
  "properties": {
    "v": { "const": 1 },
    "t": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Client epoch milliseconds." },
    "source": { "enum": ["pause", "debrief", "menu", "match"] },
    "category": { "enum": ["bug", "balance", "confusing", "idea", "praise", "rating", "report"] },
    "text": { "type": "string", "maxLength": 2000, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$" },
    "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "contact": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
    "build": { "type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,6}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "player": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "session": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "tester": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,32}$" },
    "mission": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "map": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "tick": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "dev": { "const": true },
    "context": {
      "type": "object",
      "maxProperties": 64,
      "description": "Free-form §4.1 context, shown as a key/value table in /stats/feedback. Keys the issue builder reads when present: renderer, quality, gpu (strings), viewport ([w, h]), dpr (number), locale (string). At most 8192 bytes serialised."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "rating" } }, "required": ["category"] },
      "then": {
        "required": ["rating"],
        "properties": {
          "source": { "const": "debrief" },
          "text": { "maxLength": 280, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" }
        }
      },
      "else": {
        "not": { "required": ["rating"] },
        "properties": {
          "source": { "enum": ["pause", "menu", "match"] }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "report" } }, "required": ["category"] },
      "then": {
        "properties": {
          "source": { "const": "match" },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lines", "seat", "reported_seat", "reason"],
            "properties": {
              "lines": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "pattern": "^[01]: [^\\u0000-\\u001F\\u007F]{1,280}$" } },
              "seat": { "enum": [0, 1] },
              "reported_seat": { "enum": [0, 1] },
              "reason": { "enum": ["abuse", "hate", "sexual", "threat", "spam", "other"] },
              "reported_public_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$" }
            }
          }
        },
        "not": { "anyOf": [{ "required": ["tester"] }, { "required": ["contact"] }, { "required": ["player"] }] }
      },
      "else": {
        "properties": { "source": { "enum": ["pause", "debrief", "menu"] } }
      }
    },
    {
      "if": { "properties": { "category": { "enum": ["rating", "report"] } }, "required": ["category"] },
      "else": { "properties": { "text": { "minLength": 1 } } }
    }
  ]
}

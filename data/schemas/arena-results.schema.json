{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arena-results.schema.json",
  "title": "Public arena results (GH-954 public-arena P2)",
  "description": "What `pnpm arena:publish` writes to data/arena/results.json. Closed on purpose: every object is additionalProperties false and there is no free-text field, so a note cannot be added without a schema change. Constructed from allow-listed fields, never copied and redacted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated", "note", "disclaimer", "withheld", "sections", "digest"],
  "properties": {
    "version": { "const": 1 },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "const": "These are results of this game's prompt, tools and build, not a general benchmark." },
    "disclaimer": { "const": "Model and vendor names only identify the software tested. No vendor reviewed, sponsored or endorsed these results. The game is developed with AI coding tools, and the judge is a model." },
    "withheld": { "type": "integer", "minimum": 0 },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
    "label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .:()+_-]{0,95}$" },
    "build": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+[0-9A-Za-z.-]{0,20}\\+[0-9a-f]{0,40}$" },
    "mapId": { "type": "string", "pattern": "^[a-z0-9_]{1,48}$" },
    "matchup": { "enum": ["mirror", "kdf", "sarim"] },
    "mode": { "enum": ["annihilation", "camp", "points", "flag"] },
    "by": { "enum": ["annihilation", "stalemate", "time", "cap", "forfeit", "surrender", "left", "mutual", "objective", "desync", "disagree", "timeout", "expired", "unfinished", "other"] },
    "frac": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "builds", "mixedBuilds", "games", "voids", "models", "headToHead", "byMap", "byMatchup", "endings", "rubric", "gameList"],
      "properties": {
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pace", "roundWallMs", "capTicks", "mode", "promptDigest"],
          "properties": {
            "pace": { "type": "integer", "minimum": 1 },
            "roundWallMs": { "type": "integer", "minimum": 1 },
            "capTicks": { "type": "integer", "minimum": 1 },
            "mode": { "$ref": "#/$defs/mode" },
            "promptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "builds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/build" } },
        "mixedBuilds": { "type": "boolean" },
        "games": { "$ref": "#/$defs/count" },
        "voids": { "$ref": "#/$defs/count" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
        "headToHead": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "byMap": { "type": "array", "items": { "$ref": "#/$defs/cut" } },
        "byMatchup": { "type": "array", "items": { "$ref": "#/$defs/cut" } },
        "endings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "words", "count"],
            "properties": {
              "by": { "$ref": "#/$defs/by" },
              "words": { "type": "string", "pattern": "^[a-z ]{1,24}$" },
              "count": { "$ref": "#/$defs/count" }
            }
          }
        },
        "rubric": { "type": "array", "items": { "$ref": "#/$defs/rubric" } },
        "gameList": { "type": "array", "items": { "$ref": "#/$defs/game" } }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scripted", "modelId", "games", "wins", "draws", "losses", "voids", "tooFew", "score", "interval", "bySeat", "byFaction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "scripted": { "type": "boolean" },
        "modelId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
        "games": { "$ref": "#/$defs/count" },
        "wins": { "$ref": "#/$defs/count" },
        "draws": { "$ref": "#/$defs/count" },
        "losses": { "$ref": "#/$defs/count" },
        "voids": { "$ref": "#/$defs/count" },
        "tooFew": { "type": "boolean" },
        "score": { "$ref": "#/$defs/frac" },
        "interval": { "oneOf": [{ "type": "null" }, { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } }] },
        "bySeat": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/frac" } },
        "byFaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kdf", "sarim"],
          "properties": { "kdf": { "$ref": "#/$defs/frac" }, "sarim": { "$ref": "#/$defs/frac" } }
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "n", "aWins", "draws", "bWins", "aScore", "p", "sidesSwapped", "verdict"],
      "properties": {
        "a": { "$ref": "#/$defs/id" },
        "b": { "$ref": "#/$defs/id" },
        "n": { "$ref": "#/$defs/count" },
        "aWins": { "$ref": "#/$defs/count" },
        "draws": { "$ref": "#/$defs/count" },
        "bWins": { "$ref": "#/$defs/count" },
        "aScore": { "$ref": "#/$defs/frac" },
        "p": { "$ref": "#/$defs/frac" },
        "sidesSwapped": { "type": "boolean" },
        "verdict": { "enum": ["a_ahead", "b_ahead", "not_distinguishable", "too_few"] }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "model", "n", "score"],
      "properties": {
        "value": { "type": "string", "pattern": "^[a-z0-9_]{1,48}$" },
        "model": { "$ref": "#/$defs/id" },
        "n": { "$ref": "#/$defs/count" },
        "score": { "$ref": "#/$defs/frac" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "judge", "selfJudged", "judgedK", "ofN", "overall", "criteria"],
      "properties": {
        "model": { "$ref": "#/$defs/id" },
        "judge": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/label" }] },
        "selfJudged": { "type": ["boolean", "null"] },
        "judgedK": { "$ref": "#/$defs/count" },
        "ofN": { "$ref": "#/$defs/count" },
        "overall": { "type": ["number", "null"], "minimum": 1, "maximum": 10 },
        "criteria": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z_]{1,24}$" },
          "additionalProperties": { "type": ["number", "null"], "minimum": 1, "maximum": 10 }
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "seed", "map", "matchup", "mode", "seat0", "seat1", "winner", "by", "ticks", "build"],
      "properties": {
        "run": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,119}$" },
        "seed": { "type": "integer", "minimum": 0 },
        "map": { "$ref": "#/$defs/mapId" },
        "matchup": { "$ref": "#/$defs/matchup" },
        "mode": { "$ref": "#/$defs/mode" },
        "seat0": { "$ref": "#/$defs/id" },
        "seat1": { "$ref": "#/$defs/id" },
        "winner": { "type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]{0,31}|draw|void)$" },
        "by": { "$ref": "#/$defs/by" },
        "ticks": { "type": "integer", "minimum": 0 },
        "build": { "$ref": "#/$defs/build" }
      }
    }
  }
}

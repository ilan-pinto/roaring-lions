{
  "$comment": "Battle audio manifest. Every file listed here MUST carry a license that permits redistribution in a public repo (CC0 or equivalent) -- see CONTRIBUTING.md. Files live in assets/audio/<set>/. Missing files are not an error: BattleAudio falls back to its procedural synth, so the game is never silent mid-development.",
  "version": 1,
  "master_gain": 0.9,
  "music": {
    "$comment": "Background music. One looping track, streamed through an <audio> element rather than decoded into memory (a 3.7 MB decode is ~28 MB of PCM). Starts on the first user gesture like everything else, and the same mute toggle silences it. `gain` is the element volume on the menu screens and `battle_gain` its volume inside a mission (polish pass F, A10: 0.4 and 0.26, so a bark sits ~5 LU over the music before the duck), each 0..1 and on top of master_gain. A track's `trim_db` corrects its own level: the theme's true peak reads +0.2 dBTP (ffmpeg ebur128), so -1.2 dB puts it at -1.0, and `pnpm validate:audio` re-measures that whenever ffmpeg is on PATH.",
    "gain": 0.4,
    "battle_gain": 0.26,
    "tracks": [
      {
        "file": "music/holding_the_perimeter.mp3",
        "title": "Holding the Perimeter",
        "trim_db": -1.2,
        "license": "CC-BY-4.0",
        "credit": "Ilan Pinto",
        "source": "AI-generated main theme from the prompt in docs/audio/main-theme-prompt.md, supplied by the project lead 2026-09-05"
      }
    ]
  },

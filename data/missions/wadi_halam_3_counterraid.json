    {
      "id": "kill_amir",
      "type": "eliminate_hvt",
      "primary": true,
      "target": "wh_hvt_amir",
      "text": "Kill or capture Hallaq's local commander",
      "say": { "speaker": "idit", "text": "That is Hallaq's man on this ground. He does not know where the rockets went; he knows which nights the fords were clear, and that is what puts us at the depot." }
    },

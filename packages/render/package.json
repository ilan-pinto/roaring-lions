{
  "name": "@lions/render",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The three.js renderer, VFX and audio. Imports @lions/sim types read-only; subscribes to sim events and never writes back.",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three/ThreeRenderer.ts",
    "./three-campaign": "./src/three/campaign/world-view.ts",
    "./three-front": "./src/three/front/scene-host.ts",
    "./three-garage": "./src/three/garage/garage-view.ts",
    "./terrain": "./src/three/terrain/index.ts",
    "./project": "./src/project.ts",
    "./three-camera": "./src/three/camera.ts",
    "./three-soldier": "./src/three/spike/soldier-view.ts"
  },
  "dependencies": {
    "@lions/sim": "workspace:*",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0"
  }
}

{
  "name": "@lions/tools",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript tooling over the sim: headless balance/backtest harness. Python asset/balance validators live alongside.",
  "scripts": {
    "balance": "tsx src/balance/cli.ts",
    "playtest": "tsx src/backtest/playtest.ts",
    "perf:units": "tsx src/perf/three-units.ts",
    "perf:load": "tsx src/perf/load-profile.ts",
    "golden-diff": "tsx src/golden-diff/diff.ts",
    "golden-diff:compare": "tsx src/ci/golden-diff-gate.ts",
    "golden-baseline": "tsx src/ci/three-baseline-gate.ts",
    "golden-baseline:bless": "tsx src/ci/three-baseline-gate.ts --bless",
    "encode:meshes": "tsx src/meshes/encode-meshes.ts",
    "wreck:meshes": "tsx src/meshes/wreck-pass.ts",
    "ui:shots": "tsx src/ui-review/shoot.ts",
    "plate:capture": "tsx src/perf/plate-capture.ts",
    "gait:meshes": "tsx src/meshes/gait-pass.ts",
    "test": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; exec vitest run --root .. \"$@\"' sh"
  },
  "dependencies": {
    "@lions/data": "workspace:*",
    "@lions/sim": "workspace:*"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/pngjs": "^6.0.5",
    "draco3dgltf": "^1.5.7",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2"
  }
}

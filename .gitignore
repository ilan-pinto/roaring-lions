node_modules/
dist/
.DS_Store

# The sprite sheets are retired (WP-A3.3, 5a08b70f, 2026-10-04): no rendered
# sprite output is committed any more, and nothing waits on CI regenerating
# sheets from art/src/*.blend (#28, closed). What ships is the meshes under
# art/meshes/ (the source of record) and their Draco copies in assets/meshes/.
#
# Blender sources fall into two groups, and only the second is outside git:
#
#  * AUTHORED in this repository (buildings, drones, vehicles, aircraft, and the
#    campaign and UI art under art/src/): small, so tracked in plain git. The
#    rule below matches only .blend files directly in art/src/; the negations
#    name the subdirectories anyway, so tightening it cannot drop them silently.
#
#  * SUPPLIED Meshy exports in art/blend/ (the rule further down): untracked.
#    The 2026-10-14 census found them held as a SINGLE copy in the main
#    checkout, 51 files over GitHub's 100 MiB hard limit, about 6 GB still read
#    by a current exporter and about 4 GB dead. Whether the live part goes under
#    Git LFS or stays out under a documented exception with an off-repo backup
#    is OPEN: #137, with the per-folder numbers in docs/ASSET_PROVENANCE.md
#    (outstanding item 4). ART_PIPELINE.md §8, "source alongside output", is
#    unmet for these until it is decided.
art/src/*.blend
art/src/*.blend1
!art/src/buildings/
!art/src/buildings/*.blend
# Drone sources are tracked for a different reason than the buildings: they are
# modelled from primitives in this repository, so they are both small and the
# only sources whose licence is not in doubt. The rule above happens not to
# match a subdirectory, but say it explicitly so tightening it to art/src/**
# later cannot drop them silently.
!art/src/drones/
!art/src/drones/*.blend
# Blender auto-backups: never wanted, anywhere.
*.blend1

# Brainstorming companion scratch (superpowers) — never committed.
.superpowers/

# --- showcase renders -------------------------------------------------------
# Hero stills and the drive video regenerate from tools/showcase/ plus the
# tracked art/showcase/apc_detail.blend, so only the source belongs in git.
# The stills alone are 4 MB and change every time a light moves.
art/showcase/*.png
art/showcase/*.mp4
*.blend1

# Authored vehicle sources are tracked, same reasoning as buildings and drones
# above: ART_PIPELINE.md §8 requires sources to accompany contributed art, and
# these are authored in this repository rather than downloaded geometry. Note the
# difference from buildings and drones, where the script *is* the source:
# eitan_apc.blend is flattened from a hero asset refined by eye, so the .blend is
# the authority and tools/vehicles/ is its starting point. art/showcase/README.md
# says why.
!art/src/vehicles/
!art/src/vehicles/*.blend

# Aircraft sources: same reasoning as vehicles above -- the Apache is authored
# in this repository, not downloaded geometry. art/src/aircraft/ is new; the
# blanket art/src/*.blend rule above does not recurse into subdirectories
# today, but say the negation explicitly so a future tightening to
# art/src/**/*.blend cannot drop it silently, the way it would have for the
# drones and vehicles negations above.
!art/src/aircraft/
!art/src/aircraft/*.blend

# Throwaway worktrees created by the superpowers workflow. They are checkouts
# of this repository, so leaving them untracked means a `git add -A` in a
# shared working tree can sweep a whole second copy into a commit.
# `.claude/agents/` and the rest of `.claude/` stay tracked on purpose.
.claude/worktrees/
# The supplied Meshy sources: untracked on purpose, and a single copy. See the
# header above and #137 before changing or "tidying" this line.
art/blend/

# Golden-image capture output. Both `ci.yml`'s `visual` job and
# `visual-baseline-bless.yml` pass `--out-dir=visual-baseline-output` and then
# upload it as an artifact; it is captures and diffs, never a baseline (those
# live in tools/golden-baselines/ and are committed deliberately by a bless).
/visual-baseline-output/

# Wrangler's local state (dev D1 shadow copy, cached auth, etc, WP-T1). Never
# wanted in git, and it accumulates just from running `wrangler dev`.
.wrangler/
# Wrangler's local secrets file (e.g. TICKET_SECRET for a local run). A secret
# value never goes in git.
.dev.vars
art/portraits/.roles.json

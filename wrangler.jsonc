{
	// WP-T1: the game's static build, plus /api/events and /stats.
	// GH-464: plus /api/feedback and /stats/feedback (already under the
	// run_worker_first globs below).
	// Spec: docs/superpowers/specs/2026-09-24-telemetry-design.md
	"name": "roaring-lions",
	"main": "packages/worker/src/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "packages/app/dist",
		"binding": "ASSETS",
		// The app routes by PATH (/mission/:id, /campaign); a reload on a deep
		// link must get index.html, as Pages' 404.html copy used to provide.
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/stats",
			"/stats/*"
		]
	},
	// Cloudflare's own preview URLs (<hash>.roaring-lions.workers.dev) would be
	// a second hostname serving the same /stats login -- off, so /stats is
	// reachable only through the one deployed origin.
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "roaring-lions-telemetry",
			"database_id": "d23ceb15-6f89-4bcb-bb81-559eeba98e07",
			"migrations_dir": "packages/worker/migrations"
		}
	],
	// N0 (network design §3.2): one Durable Object per match, SQLite-backed.
	// The class is exported from packages/worker/src/index.ts, and the
	// migration tag must land in the same deploy as that export.
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "MatchRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "net-v1",
			"new_sqlite_classes": ["MatchRoom"]
		}
	],
	"ratelimits": [
		{
			"name": "INGEST_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "LOGIN_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		// GH-464: POST /api/feedback, per connecting IP (never stored). The
		// session, player and global ceilings are counted in D1 instead.
		{
			"name": "FEEDBACK_LIMIT",
			"namespace_id": "1003",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		// N0: POST /api/match and /api/match/:code/join, per connecting IP.
		// Never the socket upgrade: a reconnect loop would trip it.
		{
			"name": "ROOM_LIMIT",
			"namespace_id": "1004",
			"simple": {
				"limit": 6,
				"period": 60
			}
		},
		// #559 M-1: the socket upgrade, per connecting IP. Its own limiter, so a
		// client reconnecting once a second (60 a minute) stays inside it.
		{
			"name": "WS_LIMIT",
			"namespace_id": "1005",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	// GH-464: daily at 03:17 UTC, purge feedback pictures, replays and
	// contacts older than 180 days (spec §7, D15).
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	// Workers Logs and traces, full sampling, persisted. invocation_logs stays
	// off. NOTE: redact_query_string is false, so a traced request URL keeps its
	// query string -- including a ?tester= label -- in Cloudflare's storage.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
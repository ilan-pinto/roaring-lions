{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // TS 6 folds lib.dom.iterable into lib.dom (DOM.Iterable is an empty file now).
    "lib": ["ES2022", "DOM"],
    // TS 6 (and 7) default `types` to [] instead of every @types package.
    // @types/node is the only installed one that declares globals; naming it
    // keeps every per-package tsconfig seeing what it saw under TS 5.
    "types": ["node"],
    "strict": true,
    // noUncheckedIndexedAccess is deliberately OFF: the sim hot loop indexes
    // typed arrays constantly and non-null assertions are banned in sim code.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // Vite's native config loader (`--configLoader native`, planned as the
    // default) loads packages/app/vite.config.ts through Node's own type
    // stripping, which resolves relative imports literally: that config and
    // every file it pulls in name their imports with `.ts`. Legal because
    // nothing here emits (`noEmit`); an emitting build would need
    // `rewriteRelativeImportExtensions` instead.
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
